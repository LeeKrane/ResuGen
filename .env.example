# ============================================================
# ResuGen Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
# IMPORTANT: Variables prefixed with NUXT_PUBLIC_* are exposed
# to the browser bundle. NEVER put secrets in NUXT_PUBLIC_* vars.
# ============================================================

# ------------------------------------------------------------
# SUPABASE (handled by @nuxtjs/supabase module)
# ------------------------------------------------------------
# The @nuxtjs/supabase module reads these automatically.
# SUPABASE_URL and SUPABASE_KEY are injected as public client
# config by the module — they are safe for the browser (anon key).
#
# SUPABASE_URL — Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_KEY — The **anon** (public) key. Safe for client use.
# This is NOT the service-role key.
SUPABASE_KEY=your-supabase-anon-key

# ⚠️  SUPABASE_SECRET_KEY — The **service-role** key.
# ⚠️  This key bypasses RLS and has full DB access.
# ⚠️  MUST NEVER be in client code, NUXT_PUBLIC_* vars, or browser bundles.
# ⚠️  Only used server-side (Nitro routes) when admin-level access is needed.
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# OPENAI (server-side only)
# ------------------------------------------------------------
# Used by Nitro server routes (/api/ai/*) to call OpenAI.
# Accessed via useRuntimeConfig().openaiApiKey in server code.
#
# ⚠️  This MUST remain NUXT_OPENAI_API_KEY (no NUXT_PUBLIC_ prefix).
# ⚠️  If you accidentally name it NUXT_PUBLIC_OPENAI_API_KEY,
# ⚠️  the key will be exposed in the browser bundle.
NUXT_OPENAI_API_KEY=sk-your-openai-api-key

# ------------------------------------------------------------
# SUMMARY: What's public vs. server-only
# ------------------------------------------------------------
# PUBLIC (safe for browser):
#   SUPABASE_URL          — Project URL (injected by @nuxtjs/supabase)
#   SUPABASE_KEY          — Anon key (injected by @nuxtjs/supabase)
#
# SERVER-ONLY (never in browser):
#   SUPABASE_SECRET_KEY   — Service-role key (bypasses RLS)
#   NUXT_OPENAI_API_KEY   — OpenAI API key
# ------------------------------------------------------------
