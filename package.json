{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:host": "nuxt dev --host",
    "build": "nuxt build",
    "build:analyze": "nuxt build --analyze",
    "preview": "nuxt preview",
    "start": "NODE_PATH=./node_modules node .output/server/index.mjs",
    "serve": "pnpm run build && pnpm run start",
    "generate": "nuxt generate",
    "generate:modern": "nuxt generate --modern",
    "clean": "rm -rf .nuxt .output dist .cache",
    "clean:all": "npm run clean && rm -rf node_modules",
    "postinstall": "nuxt prepare",
    "update-deps": "pnpm update",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prod:build": "pnpm run clean && pnpm run build",
    "deploy": "pnpm run clean && pnpm run build && pnpm run start"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.64",
    "@iconify-json/simple-icons": "^1.2.49",
    "@internationalized/date": "^3.9.0",
    "@node-rs/argon2": "^2.0.2",
    "@nuxt/image": "1.10.0",
    "@nuxt/ui": "4.0.0-alpha.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "nuxt": "^4.0.3",
    "nuxt-particles": "^0.3.0",
    "nuxt-security": "^2.5.0",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.3",
    "uuid": "^11.1.0",
    "valibot": "^1.1.0",
    "vue-to-print": "^1.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^3.20.1",
    "@nuxtjs/supabase": "^1.6.1",
    "@types/node": "^25.3.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.34.0",
    "fast-check": "^4.3.0",
    "happy-dom": "^20.6.3",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.19"
    },
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    }
  },
  "engines": {
    "node": "22"
  }
}
